{
  "name": "kantorku",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "main": "electron-main.cjs",
  "description": "Game simulasi karier kantor berbahasa Indonesia",
  "author": "Rafiabdillah",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:build": "cross-env VITE_BASE_PATH=./ vite build",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis portable --publish never",
    "desktop:start": "npm run desktop:build && electron .",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/tests/*.test.ts",
    "content:report": "tsx scripts/contentReport.ts",
    "content:audit": "tsx scripts/contentAudit.ts",
    "skills:audit": "tsx scripts/auditSkills.ts",
    "check": "npm run lint && npm test && npm run skills:audit && npm run test:e2e && npm run build",
    "test:e2e": "playwright test tests/e2e/"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-table-cell": "3.32.2",
    "@tiptap/extension-table-header": "3.32.2",
    "@tiptap/extension-table-row": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.15.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "id.rafiabdillah.kantorku",
    "productName": "KantorKu",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/pwa-512x512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "KantorKu-Setup.exe",
      "shortcutName": "KantorKu"
    },
    "portable": {
      "artifactName": "KantorKu-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
